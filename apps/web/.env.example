# Copy to .env.local for local work, or set these in Vercel → Project → Settings → Environment Variables.
# Every service is off while its variables are empty: nothing is sent anywhere.

# Database (Neon): challenge short codes, reports, answer statistics.
DATABASE_URL=

# Errors: Sentry → Project settings → Client Keys (DSN). The public DSN is safe to expose.
NEXT_PUBLIC_SENTRY_DSN=
# Readable stack traces: Sentry → Settings → Auth Tokens (scope project:releases). Build-time only, keep secret.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Usage statistics: PostHog → Project settings → Project API key (starts with phc_). Region "us" or "eu".
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_REGION=us

# Logs: Axiom → Datasets (create one) and Settings → API tokens (ingest permission for that dataset). Keep secret.
AXIOM_DATASET=
AXIOM_TOKEN=
