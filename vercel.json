{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm turbo run build --filter=@meridian/web",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/internal/dedupe-reports",
      "schedule": "17 4 * * *"
    }
  ]
}
